// Every hook the context monitor installs, in one place, defined once at
// startup. The poll calls __cm_ensureHooks() and the guards inside decide
// whether anything needs doing -- kag.selectLayer is replaced over a session,
// so that one really does have to be re-checked rather than installed once.
//
// Hooks stay dumb collectors: they run on native dispatch paths, outside the
// poll's try/catch, so an uncaught exception in one reaches the engine and can
// be fatal.
(function() {
	// Scenario text as the renderer receives it, turned into what the reader
	// should get. Shared rather than inlined where it is used: the same strings
	// reach the context by two routes -- dialogue through the hook below, and
	// the options of a choice read directly by the poll -- and a rule applied
	// on one route only is a rule that will drift.
	//
	// Of the three notations in the text, two describe how to draw and one
	// means something. A font switch wraps a note character so it renders in a
	// Japanese face, and a numbered style marks the diary inserts: both go. The
	// italic pair marks the stressed word, so it becomes Markdown, which is
	// what the API asks context messages to be written in.
	//
	// The line break stays but travels escaped: events reach the plugin as
	// lines with tab-separated fields, so a real break would end the record
	// halfway and leave the rest looking like an event of its own. The C++ side
	// restores it when the message is built.
	//
	// Japanese ruby (`[かな,N]`) is deliberately left alone. It is a reading aid
	// rather than layout noise, and it never appears in the language this reads.
	global.__cm_cleanText = function(text) {
		var clean = "" + text;
		clean = clean.replace(/%f[^;]*;/g, "");
		clean = clean.replace(/%n[0-9];/g, "");
		clean = clean.replace(/%i[1d]/g, "*");
		clean = clean.replace(/\n/g, "\\n");
		return clean;
	} incontextof global;

	global.__cm_ensureHooks = function() {
    // --- Localized text and speaker name, via a kag.getLangInfo call-through.
    //     getLangInfo(arg0, field) is the single choke point the engine's own
    //     renderer (rendermsgwin drawName/drawHistory, SelectLayer) goes through
    //     to resolve arg0.language[kag.languageType][field], so intercepting it
    //     yields exactly what the player sees.
    if (typeof global.__cm_origGetLangInfo == "undefined") {
      global.__cm_langText = "";
      global.__cm_langName = "";
      global.__cm_origGetLangInfo = kag.getLangInfo;
      kag.getLangInfo = function(arg0, arg1, arg2) {
        // The original declares `arg2 = languageType` as a default parameter.
        // A plain call-through wrapper does NOT get that default for free: an
        // ordinary 2-arg call (kag.getLangInfo(arg0, "text"), used everywhere)
        // leaves arg2 undefined here, and forwarding that explicit void to the
        // original does not trigger ITS default either -- arg0.language[void]
        // inside the original then indexes a native array out of bounds, which
        // is a real engine crash (Hardware exception raised), not a catchable
        // TJS error. This default MUST be preserved before calling through.
        if (arg2 === void) arg2 = kag.languageType;
        // Guarded because this runs inside the engine's own renderer, where an
        // exception is fatal. An empty answer there costs a blank line; calling
        // a missing original costs the process.
        //
        // Called as a plain function rather than in the context of kag, which
        // is how it has run through every measurement so far. The original does
        // not reach for its owner -- it resolves the entry it is handed -- and
        // this is the hottest path in the game, so it is left as measured.
        if (typeof global.__cm_origGetLangInfo != "Object") return "";
        var r = global.__cm_origGetLangInfo(arg0, arg1, arg2);
        try {
          if (arg1 == "text") {
            // "text" is the field the renderer asks for, so it still carries
            // the inline directives; the entry's "speechtext" is free of them
            // but is prepared for speaking and has the line breaks taken out
            // with the markup, which would flatten the diary inserts the player
            // reads as paragraphs. Hence the shared cleaner above rather than
            // the other field.
            global.__cm_langText = global.__cm_cleanText(r);
            // The entry itself, not just the rendered string: keeping it lets
            // the same line be read back in another language later, since
            // getLangInfo takes the language as its third argument. The raw
            // currentText property bypasses the language table entirely.
            global.__cm_langEntry = arg0;
          } else if (arg1 == "disp") global.__cm_langName = "" + r;
        } catch (e) {}
        return r;
      };
    }

    // --- Semantic event queue. Accumulated by hooks at the moment an event
    //     actually happens, drained once per poll. Hooks stay dumb collectors:
    //     they run on native dispatch paths, outside this poll's try/catch, so
    //     an uncaught exception in one reaches the engine and can be fatal.
    //     Field separator is \t, and free text is always the last field, so the
    //     C++ side can split on a fixed number of separators.
    if (typeof global.__cm_events == "undefined") global.__cm_events = [];

    // dialogue: fires on [p], i.e. once a page is fully shown. Localized values
    // come from the getLangInfo snapshot above, which is current at this point.
    if (typeof global.__cm_origP == "undefined") {
      global.__cm_origP = kag.tagHandlers["p"];
      kag.tagHandlers["p"] = function(p) {
        // This IS the [p] handler now. If the capture throws, the call-through
        // below must still run so [p] keeps working exactly as before.
        try {
          global.__cm_events.add("dialogue\t" + global.__cm_langName + "\t" + global.__cm_langText);
        } catch (e) {}
        return global.__cm_origP(p);
      };
    }

    // se: one-shot story sound effects. Unlike music and looping backgrounds,
    // these leave no state to poll -- the call is the only evidence they
    // happened, and between two polls there may be several. Patching the class
    // rather than the live layers is deliberate: TJS2 copies members into an
    // object at construction, so a class patch reaches every layer built after
    // it, and the sound layers are rebuilt with every scene. Installed once.
    if (typeof global.EnvSoundBuffer != "undefined" &&
        typeof global.__cm_origSePlay == "undefined") {
      global.__cm_origSePlay = global.EnvSoundBuffer.play;
      global.EnvSoundBuffer.play = function(a0, a1, a2, a3, a4) {
        try {
          global.__cm_events.add("se	" + a0);
        } catch (e) {}
        // Guarded and outside the try above: this is the engine's own playback
        // path, and losing the call would silence the effect rather than just
        // lose an event.
        var original = global.__cm_origSePlay;
        if (typeof original != "Object") return void;
        return (original incontextof this)(a0, a1, a2, a3, a4);
      };
    }

    // The CG gallery keeps which pictures have been seen on its own controller,
    // and the screen object reachable as Current exposes only the page number.
    // isSeenOne runs while the thumbnails are drawn, so wrapping it once catches
    // the instance without forcing anything.
    if (typeof global.CgGalleryMode != "undefined" &&
        typeof global.__cm_origSeenOne == "undefined") {
      global.__cm_gallery = void;
      global.__cm_origSeenOne = global.CgGalleryMode.isSeenOne;
      global.CgGalleryMode.isSeenOne = function(a0, a1) {
        global.__cm_gallery = this;
        // Guarded and called with its instance: this is a class patch, so it
        // outlives the global holding the original, and the original is a
        // method that expects the object it was taken from.
        var seen = global.__cm_origSeenOne;
        if (typeof seen != "Object") return;
        return (seen incontextof this)(a0, a1);
      };
      // isSeenOne only runs while the grid is being built, so a handle taken
      // there is stale the moment a picture opens over it -- and the opened view
      // runs on a different controller instance. focusView is what that instance
      // calls as it takes over, which is the one that can close it again.
      global.__cm_origFocusView = global.CgGalleryMode.focusView;
      global.CgGalleryMode.focusView = function() {
        global.__cm_gallery = this;
        var focus = global.__cm_origFocusView;
        if (typeof focus != "Object") return;
        return (focus incontextof this)();
      };
    }

    // The backlog is a view, not a store: its getBlockCount/getBlockInfo proxy
    // into playerObject.getHistoryCount/getHistoryData, which hold the whole
    // conversation. The controller instance is not exposed, so the class method
    // is wrapped once and the instance caught as it goes by -- the same trick as
    // the save store below.
    if (typeof global.DragScrollableBacklog != "undefined" &&
        typeof global.__cm_origBlockInfo == "undefined") {
      global.__cm_backlog = void;
      global.__cm_origBlockInfo = global.DragScrollableBacklog.getBlockInfo;
      global.DragScrollableBacklog.getBlockInfo = function(a0) {
        global.__cm_backlog = this;
        var info = global.__cm_origBlockInfo;
        if (typeof info != "Object") return;
        return (info incontextof this)(a0);
      };
    }

    // The save/load list has no readable "which page is showing" anywhere on the
    // screen: curpage.caption is empty and kag.current carries no index. The
    // store object does have it, but nothing exposes the instance -- so the
    // class method is wrapped once and the instance is caught as it goes by.
    //     onScrolled fires for both ways of paging, the page buttons and the
    //     mouse wheel, so neither can desync the reading. The instance dies with
    //     the screen ("The object is already invalidated"), which is why every
    //     read has to be guarded rather than cached.
    if (typeof global.EditableStoreScroll != "undefined" &&
        typeof global.__cm_origScrolled == "undefined") {
      global.__cm_saveStore = void;
      global.__cm_origScrolled = global.EditableStoreScroll.onScrolled;
      global.EditableStoreScroll.onScrolled = function(a0, a1) {
        global.__cm_saveStore = this;
        // Guarded and called with the owner it was taken from. A class patch
        // outlives the globals that hold its saved original, and calling void
        // from here lands in the engine's own dispatch, where nothing catches
        // it. `incontextof this` because the original is a method: reached as
        // a plain global function it would run without its instance.
        var original = global.__cm_origScrolled;
        if (typeof original != "Object") return;
        return (original incontextof this)(a0, a1);
      };
    }

    // restore: a save loaded, or a jump taken through the backlog. The engine
    // tells its plugins as it puts the flags back, and nothing else marks the
    // moment -- afterwards the story simply stands somewhere else. A dictionary
    // rather than an object: the engine asks each plugin for members by name,
    // and a dictionary answers void for the ones it does not have.
    if (typeof global.__cm_restorePlugin == "undefined" &&
        typeof kag.addPlugin == "Object") {
      global.__cm_restores = 0;
      global.__cm_restorePlugin = %[
        "onRestore" => function(flags, clear, options) {
          try { global.__cm_restores++; } catch (e) {}
        } incontextof global
      ];
      kag.addPlugin(global.__cm_restorePlugin);
    }

    // choice_made: the engine's own click dispatch, which is also what the
    // select_choice action calls. The button object carries the chosen option,
    // so its localized text comes from the same getLangInfo path as the render.
    //     The marker lives on the layer, not in a global, because kag.selectLayer
    //     is replaced over the session: a one-shot global guard would leave every
    //     later layer unhooked, and the first choice after a scene entry would
    //     emit nothing. Marking the layer re-hooks each new one on the next poll,
    //     and keeping the saved original on the layer as well means the
    //     call-through runs with the correct owner as `this`.
    if (typeof kag.selectLayer != "undefined" &&
        typeof kag.selectLayer.onButtonClick != "undefined" &&
        typeof kag.selectLayer.__cm_hooked == "undefined") {
      kag.selectLayer.__cm_hooked = 1;
      kag.selectLayer.__cm_origClick = kag.selectLayer.onButtonClick;
      kag.selectLayer.onButtonClick = function(button) {
        try {
          global.__cm_events.add("choice_made\t" + kag.getLangInfo(button, "text"));
        } catch (e) {}
        // The saved original lives on the layer beside the marker, so the two
        // normally go together -- but this runs on the engine's click dispatch,
        // where an exception is fatal, and the cost of asking is one comparison.
        if (typeof this.__cm_origClick != "Object") return;
        return this.__cm_origClick(button);
      };
    }
	} incontextof global;
	return 1;
})();
