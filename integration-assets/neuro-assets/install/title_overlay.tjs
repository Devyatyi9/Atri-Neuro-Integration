// Title overlay: Picture laid over the second title background,
// revealed by a wipe with pixel squares along its edge. The plugin calls arm()
// when the title becomes ready; the animation runs only while it plays.

class NeuroTitleOverlay {
	var W = 707, H = 720, X = 573, Y = 0;
	var M = 60;             // particle layer margin around the picture
	var DELAY = 2000;       // wait after the title is ready before the automatic show

	var wcurve = "decel", wms = 900;
	var fcurve = "accel", fms = 1250;
	var opFrom = 10, opTo = 255;
	var feather = 24;
	var edgeOff = 20;       // particles are born this far below the edge
	var stopEarly = 50;     // no births in the last ms of the wipe
	var autoK = 1.5;        // the automatic change runs slower than a manual one
	var manualK = 0.5;      // and a manual one spawns fewer particles
	var dens = [1.0, 1.0, 0.15, 0.5];              // start, middle, at, end
	var env = [255, 235, 0.75, 125];               // emitter opacity envelope
	var envMs = 50, envCurve = "decel";
	// The picture comes in from slightly above, settling from the start of the
	// wipe; only on the way in.
	var shiftPx = 17, shiftMs = 350, shiftCurve = "decel";

	var host, src, pic, pt;
	var pw = 0.0, pf = 0.0, target = 0.0;
	var shown = -1, edge = 0, redraw = false;
	var manual = false, t0 = 0, last = 0, startAt = 0;
	var running = false, storage = "";
	var shifting = false;
	var syncEmitter = false;
	var settled = false;    // animation finished; only the page watch is left
	var watching = false;   // a menu is open; kept until the title is ready again
	var wanted = true;      // the player's last choice, kept across menus
	var hit;                // click area over the picture, on the message layer
	var hitStorage = "";
	var hitOn = false;

	function NeuroTitleOverlay() {
		Storages.addAutoPath(System.exePath + "neuro-assets/images/");
		Neuro.mountAssets();
	}

	function finalize() {
		stop();
		freeLayers();
		if (hit !== void && isvalid hit) invalidate hit;
	}

	function curve(name, t) {
		if (name == "accel") return t * t;
		if (name == "decel") return t * (2 - t);
		return t;
	}

	function pw3(v, t) {
		if (t < 0) t = 0;
		if (t > 1) t = 1;
		if (t <= v[2]) return v[0] + (v[1] - v[0]) * t / v[2];
		return v[1] + (v[3] - v[1]) * (t - v[2]) / (1 - v[2]);
	}

	// The front page first; a title being built on the back page before its
	// transition counts too, so the picture is there as the title fades in.
	function findHost() {
		var h = findOn(kag.fore.base);
		return h !== void ? h : findOn(kag.back.base);
	}

	function findOn(b) {
		for (var i = 0; i < b.children.count; i++) {
			if (b.children[i].name == "title_image") return b.children[i];
		}
		return void;
	}

	function alive() {
		return pic !== void && isvalid pic && host !== void && isvalid host;
	}

	function freeLayers() {
		if (pt !== void && isvalid pt) invalidate pt;
		if (pic !== void && isvalid pic) invalidate pic;
		if (src !== void && isvalid src) invalidate src;
		pt = pic = src = host = void;
	}

	// Layers are children of title_image, so they leave together with the title.
	function build() {
		freeLayers();
		host = findHost();
		if (host === void) return false;
		src = new Layer(kag, host);
		// The pictures are stored without an extension; neuro:// adds it.
		src.loadImages("neuro://./images/" + storage + ".png");
		src.visible = false;
		pic = new Layer(kag, host);
		pic.setImageSize(W, H);
		pic.setSizeToImageSize();
		pic.type = ltAlpha;
		pic.fillRect(0, 0, W, H, 0);
		pic.setPos(X, Y);
		pic.visible = false;

		// ParticleController sizes itself from these; other effects read them
		// too (the exit fade), so they are put back right after.
		var exW = kag.exWidth, exH = kag.exHeight;
		kag.exWidth = W + M * 2;
		kag.exHeight = H + M * 2;
		pt = new ParticleController(kag);
		kag.exWidth = exW;
		kag.exHeight = exH;
		pt.parent = host;
		pt.config = %[
			storage: "px_flicker_additive_grad.png", rows: 4, columns: 5,
			angle: "255/285", speed: "60/170", life: "1350/2050",
			fade: 225, patsp: 140, vibsp: 0, vibsz: 0, ctx: "", cty: "",
			genratio: 0, genpos: %[x: 0, y: 0], nofast: 0
		];
		pt.init();
		pt.genpos = genpos;
		pt.setPos(X - M, Y - M);
		pt.type = ltAdditive;
		// Shown only once frames flow: before its first flipUpdate the emitter's
		// buffer is not cleared and reads as a white rectangle.
		pt.visible = false;
		return true;
	}

	// Births only over the opaque part of the picture, on the edge row.
	function genpos() {
		var x = pt.rand.random() * W;
		var row = (int)edge;
		if (row < 0) row = 0;
		if (row > H - 1) row = H - 1;
		for (var i = 0; i < 12; i++) {
			if (src.getMaskPixel((int)x, row) > 32) break;
			x = pt.rand.random() * W;
		}
		return %[x: M + x, y: M + edge + edgeOff + (pic.top - Y)];
	}

	// The full-screen message layer takes every click on the title, the menu
	// buttons included, so the click area is a child of it rather than of
	// title_image. It follows the front page's layer and is only switched on
	// while the title itself is up.
	function ensureHit() {
		var m = kag.fore.messages[0];
		if (hit === void || !isvalid hit || hit.parent !== m) {
			if (hit !== void && isvalid hit) invalidate hit;
			hit = new Layer(kag, m);
			hit.name = "neuro_overlay_hit";
			hit.setPos(X - m.left, Y - m.top);
			hit.hitType = htMask;
			// Hit only over the opaque part of the picture: the hit test reads the
			// layer's own alpha, and opacity 0 keeps the copy invisible.
			hit.hitThreshold = 64;
			hit.opacity = 0;
			hitStorage = "";
			hit.onMouseDown = function(x, y, button, shift) {
				if (button == mbLeft) global.neuroTitleOverlay.click();
			};
			hit.visible = hitOn;
			updateCursor();
		}
		if (hitStorage != storage && storage != "") {
			hit.loadImages("neuro://./images/" + storage + ".png");
			hit.setSizeToImageSize();
			hitStorage = storage;
		}
		return hit;
	}

	function setHit(on) {
		hitOn = on;
		if (on) {
			ensureHit().visible = true;
			updateCursor();
		} else if (hit !== void && isvalid hit) {
			hit.visible = false;
		}
	}

	// The hand only while a click would do something; the ordinary arrow while
	// the wipe is moving. The fade and the particles may still finish after it.
	function updateCursor() {
		if (hit === void || !isvalid hit) return;
		hit.cursor = busy() ? kag.cursorDefault : kag.cursorPointed;
	}

	// Nothing left to follow: the picture and the click area are on the front page.
	function canStop() {
		return !watching && host.parent === kag.fore.base &&
		       (!hitOn || hit.parent === kag.fore.messages[0]);
	}

	function busy() {
		return running && pw != target;
	}

	// Automatic show after the delay, which also resets the player's choice;
	// instant is a return from a menu, where the title comes back as it was
	// left, shown or hidden. The menus swap KAG pages, so layers from before may
	// sit on the other page's title_image: only layers on the current one count.
	function arm(name, instant = false) {
		if (sf.allcflag != 1) return "first background";
		var same = storage == name;
		storage = name;
		setHit(true);
		if (alive() && host === findHost() && same &&
		    target == (wanted ? 1.0 : 0.0)) {
			watching = false;
			return "already shown";
		}
		watching = false;
		build();
		if (!instant) wanted = true;
		target = wanted ? 1.0 : 0.0;
		manual = false;
		shown = -1;
		settled = false;
		shifting = !instant && target > 0.5;
		if (instant) {
			pw = pf = target;
			redraw = true;
			startAt = System.getTickCount();
		} else {
			pw = pf = 0.0;
			startAt = System.getTickCount() + DELAY;
		}
		start();
		return instant ? "shown" : "armed";
	}

	// A new character while the title is up: the picture changes in place.
	function setPicture(name) {
		if (name == storage) return "same";
		storage = name;
		if (hit !== void && isvalid hit && hit.visible) ensureHit();
		if (!alive()) return "stored";
		src.loadImages("neuro://./images/" + storage + ".png");
		if (settled && target > 0.5) {
			draw(H, 0, false, 0);
		} else {
			redraw = true;
		}
		return "changed";
	}

	// A menu opened over the title: keep watching the pages so the picture is
	// on the title_image the title comes back with, before it fades in.
	function watch() {
		setHit(false);
		if (storage == "") return;
		watching = true;
		if (running) return;
		System.addContinuousHandler(tick);
		running = true;
	}

	// The title is left for the game: nothing to wait for any more.
	function leave() {
		setHit(false);
		watching = false;
		stop();
		freeLayers();
		target = 0.0;
	}

	// The exit fades the screen without touching title_image, so the picture is
	// hidden by hand when the game closes.
	function hideNow() {
		setHit(false);
		stop();
		if (pic !== void && isvalid pic) pic.visible = false;
		if (pt !== void && isvalid pt) pt.visible = false;
	}

	function click() {
		if (!busy()) toggle();
	}

	// Manual switch, from a click or Neuro's action: show if hidden, hide if
	// shown. Refused while the wipe is still moving.
	function toggle() {
		if (busy()) return "busy";
		if (!alive() && (findHost() === void || !build())) return "not on title";
		target = (target > 0.5) ? 0.0 : 1.0;
		wanted = target > 0.5;
		shifting = target > 0.5 && pw == 0;
		manual = true;
		settled = false;
		redraw = true;
		startAt = System.getTickCount();
		start();
		return target > 0.5 ? "shown" : "hidden";
	}

	function start() {
		t0 = last = startAt;
		syncEmitter = true;
		if (!running) {
			System.addContinuousHandler(tick);
			running = true;
		}
		updateCursor();
	}

	function stop() {
		if (running) {
			System.removeContinuousHandler(tick);
			running = false;
		}
		updateCursor();
	}

	function tick(tickCount) {
		var now = System.getTickCount();
		// Menus over the title replace title_image. While the picture is meant to
		// be up it waits through them and follows to the new title_image keeping
		// its progress; leave() ends the wait when the title is left for good.
		if (!alive() || host !== findHost()) {
			if (findHost() === void || !build()) {
				if (!watching) {
					stop();
					freeLayers();
				}
				return;
			}
			shown = -1;
			redraw = true;
			settled = false;
		}
		// The click area moves with the front page too.
		if (hitOn) ensureHit();
		if (settled) {
			if (canStop()) stop();
			return;
		}
		if (now < startAt) return;
		// The emitter births genratio times the time since its last update, and
		// between animations nothing updates it: its clock is brought up to now
		// with nothing to birth before the first frame of each animation.
		if (syncEmitter || !pt.visible) {
			pt.genratio = 0;
			pt.flipUpdate(now, now, 0);
			pt.visible = true;
			syncEmitter = false;
		}
		var dt = now - last;
		last = now;
		if (dt < 0) dt = 0;
		if (dt > 100) dt = 100;
		var sk = manual ? 1.0 : autoK;

		var p = pw;
		var moving = (p != target);
		if (moving) {
			var sw = dt / (wms * sk);
			p = (target > p) ? p + sw : p - sw;
			if ((target > pw && p > target) || (target < pw && p < target)) p = target;
			pw = p;
			if (p == target) updateCursor();
		}
		var fading = (pf != target);
		if (fading) {
			var sf2 = dt / (fms * sk);
			var q = (target > pf) ? pf + sf2 : pf - sf2;
			if ((target > pf && q > target) || (target < pf && q < target)) q = target;
			pf = q;
		}

		// Hiding mirrors the appear: the background comes in on the same forward
		// curves, the part above the edge fading out, the part below still whole.
		var hiding = target < 0.5;
		var dy = 0;
		if (shifting && !hiding) {
			var st = (now - t0) / (shiftMs * sk);
			if (st >= 1) shifting = false;
			else dy = (int)(shiftPx * (1 - curve(shiftCurve, st)));
		}
		if (pic.top != Y - dy) pic.top = Y - dy;
		var cur, topOp = 0;
		if (hiding) {
			cur = H - (int)(H * curve(wcurve, 1 - pw));
			var bg = opFrom + (opTo - opFrom) * curve(fcurve, 1 - pf);
			topOp = (int)(opTo * (1 - bg / 255));
		} else {
			cur = (int)(H * curve(wcurve, pw));
		}
		var cut = hiding ? H - cur : 0;

		if (cur != shown || redraw || (hiding && fading)) {
			redraw = false;
			if (cur < 1 && !(hiding && pf > 0)) {
				pic.visible = false;
			} else {
				draw(cur, cut, hiding, topOp);
				pic.visible = true;
			}
			var delta = (shown < 0) ? 0 : cur - shown;
			if (delta < 0) delta = -delta;
			var run = hiding ? 1 - pw : pw;
			var d = pw3(dens, run) * (manual ? manualK : 1.0);
			var late = run > 1 - stopEarly / (wms * sk);
			pt.genratio = (moving && !late) ? (20 + delta * 14) * d : 0;
			shown = cur;
		} else if (!moving) {
			pt.genratio = 0;
		}
		if (pic.visible) {
			var fe = curve(fcurve, pf);
			pic.opacity = hiding ? 255 : (int)(opFrom + (opTo - opFrom) * fe);
		}

		var et = (now - t0) / (envMs * sk);
		if (et > 1) et = 1;
		var ee, eo;
		if (et <= env[2]) {
			ee = curve(envCurve, et / env[2]);
			eo = env[0] + (env[1] - env[0]) * ee;
		} else {
			ee = curve(envCurve, (et - env[2]) / (1 - env[2]));
			eo = env[1] + (env[3] - env[1]) * ee;
		}
		pt.opacity = (int)eo;

		edge = hiding ? cut : cur;
		pt.flipUpdate(now, now, 0);

		// Done once both clocks arrived and the last particles have died out.
		// A picture parked on the back page behind a menu keeps the watch going.
		if (!moving && !fading && now - t0 > (wms + fms) * sk + 2100) {
			pt.genratio = 0;
			settled = true;
			updateCursor();
			if (canStop()) stop();
		}
	}

	function draw(cur, cut, hiding, topOp) {
		pic.fillRect(0, 0, W, H, 0);
		var fw = feather;
		// The band centre runs from -fw/2 to H+fw/2 so no half band is left at the end.
		var edgeY = (hiding ? cut : cur) * (1 + fw / H) - fw / 2;
		if (hiding && topOp > 0) {
			var topEnd = (int)(edgeY - fw / 2);
			if (topEnd > H) topEnd = H;
			if (topEnd > 0) pic.operateRect(0, 0, src, 0, 0, W, topEnd, omAuto, topOp);
		}
		var solidTop = hiding ? edgeY + fw / 2 : 0;
		var solidBottom = hiding ? H : edgeY - fw / 2;
		if (solidTop < 0) solidTop = 0;
		if (solidBottom > H) solidBottom = H;
		if (solidBottom > solidTop) {
			pic.copyRect(0, (int)solidTop, src, 0, (int)solidTop, W, (int)(solidBottom - solidTop));
		}
		for (var fy = edgeY - fw / 2; fy < edgeY + fw / 2; fy += 2) {
			var fr = (fy + 1 - (edgeY - fw / 2)) / fw;
			var fa = hiding ? fr : 1 - fr;
			var yy = (int)fy;
			var fo = (int)(topOp + (255 - topOp) * fa);
			if (yy < 0 || yy + 2 > H || fo <= 0) continue;
			pic.operateRect(0, yy, src, 0, yy, W, 2, omAuto, fo);
		}
	}
}

if (typeof global.neuroTitleOverlay != "undefined" && global.neuroTitleOverlay !== void) {
	invalidate global.neuroTitleOverlay;
}
global.neuroTitleOverlay = new NeuroTitleOverlay();

// Hooks outlive a reload of this script, so they are added once and look the
// current instance up when they fire.
if (typeof global.neuroTitleOverlayHooked == "undefined") {
	global.neuroTitleOverlayHooked = true;
	var hideOverlay = function() {
		if (typeof global.neuroTitleOverlay == "Object" && isvalid global.neuroTitleOverlay)
			global.neuroTitleOverlay.hideNow();
	};
	kag.addHook("onCloseHook", hideOverlay);
	kag.addHook("onShutdown", hideOverlay);
}
