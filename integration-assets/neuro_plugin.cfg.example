# Plugin settings. Copy into the game's folder to use.
#
# Only what two copies of the game cannot share lives here. Everything else the
# plugin does is per-process and needs no configuration.
#
# Which file is read, first match wins:
#   1. the path in the NEURO_PLUGIN_CONFIG environment variable
#   2. <exe name>.neuro.cfg   beside the exe
#   3. neuro_plugin.cfg       beside the exe
#   4. nothing -- the defaults below are used
#
# The second form is what makes a second copy work with no launcher: copy the
# exe, put ATRI-MyDearMoments-_Copy.neuro.cfg beside it, and that copy picks up
# its own port and log directory by itself.
#
# Read once, at startup. Changing it while the game runs has no effect: a port
# cannot move under a listening socket, nor a path under an open file.

# The plugin's TCP port. Machine-wide, so two instances must not share it --
# and sharing it does not fail cleanly. The socket is opened with SO_REUSEADDR,
# which on Windows lets a second bind succeed rather than refusing it, after
# which connections go to whichever socket the stack picks.
tcp_port = 18700

# Where plugin_log.txt, neuro_tag_log.txt and game_debug_log.txt are written,
# along with the Logs\ folder the previous run's copies are moved into. Created
# if missing. Empty (the default) means the game's own folder, which is where
# every earlier version put them.
#
# Name it after the instance rather than after logs: the rotation folder inside
# it is already called Logs, and "logs-copy\Logs" reads as the same word twice.
#   log_dir = D:\Games\ATRI-TestVersion\instance-copy
#
# Nothing marks a log file as belonging to an instance -- they are told apart by
# path and by nothing else. Point two instances at one directory and the second
# finds the first's log already there, cannot move it aside because it is open,
# and appends into it. Each log opens with a "# instance pid=... exe=... port=...
# config=..." line, which is what makes such a mixed file readable afterwards;
# it is not a guard, so give each instance its own directory.
log_dir =

# Stamp every line of neuro_tag_log.txt with the local time, offset included:
#   2026-09-05T17:12:33.412+03:00 [bgm] BGM09
# Off by default. The log is read on its own far more often than it is joined
# against anything, and the stamp is wider than most of the lines it prefixes.
#
# Turn it on to reconstruct a run: what the game reported, what the client sent
# and what came back are three separate records, and a shared clock is what puts
# them in one order. Every line of a single poll carries the same stamp -- they
# were observed together, and spreading them apart would invent an order.
#
# on/true/yes/1 and off/false/no/0 are all understood; anything else leaves the
# setting alone, because a run silently written in the other format is worse
# than one that ignored the line.
log_timestamps = off
