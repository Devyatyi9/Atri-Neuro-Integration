// Auto and skip, for the context monitor.
//
// Skip is the raw level, not on/off: 0 none, 1 click, 2 page, 3 to next stop,
// 4 fast, 5 to label, 6 cancel, 7 force. Only 3 and above are the mode a player
// turns on; 1 and 2 pass through on ordinary clicks.
(function() {
	global.__cm_collectModes = function() {
		return %[
			"auto" => kag._autoMode,
			"skip" => kag._skipMode
		];
	} incontextof global;
	return 1;
})();
