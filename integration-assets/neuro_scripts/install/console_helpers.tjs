// Short names for playing a sound by hand from the console.
//
// Each kind of sound has its own buffer and its own signature, and none of the
// three is guessable, so typing them out every time is a small tax on every
// "what does this file sound like" question. These wrap them.
//
//   pv("ATR_b203_044")   voice
//   pse("se171")         sound effect
//   pbgm("BGM09")        music, replaces what is playing
//   pstop()              stops all three
//
// The extension goes on the name, not on the caller: voice is .opus, the other
// two take a bare name.
(function() {
	global.pv = function(name) {
		var buffer = global.kag.voices[0];
		buffer.stop();
		buffer.open(name + ".opus");
		buffer.play();
		return buffer.storage;
	} incontextof global;

	global.pse = function(name) {
		global.kag.se[0].play(%[ storage: name ]);
		return name;
	} incontextof global;

	// Music is the one that displaces something. pbgmback() puts back whatever
	// pbgm interrupted, which on an instance you are also playing on is usually
	// what you want next.
	global.pbgm = function(name) {
		global.__pbgmPrevious = "" + global.kag.bgm.playingStorage;
		global.kag.bgm.play(%[ storage: name, loop: true ]);
		return global.kag.bgm.playingStorage;
	} incontextof global;

	global.pbgmback = function() {
		if (typeof global.__pbgmPrevious != "String" || global.__pbgmPrevious == "") {
			return "";
		}
		global.kag.bgm.play(%[ storage: global.__pbgmPrevious, loop: true ]);
		return global.kag.bgm.playingStorage;
	} incontextof global;

	global.pstop = function() {
		try { global.kag.voices[0].stop(); } catch (e) {}
		try { global.kag.se[0].stop(); } catch (e) {}
		try { global.kag.bgm.stop(); } catch (e) {}
		return "stopped";
	} incontextof global;

	return 1;
})();
