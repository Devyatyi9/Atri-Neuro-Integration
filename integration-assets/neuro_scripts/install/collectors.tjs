// Loads the context monitor's collectors, once, at startup. They define
// themselves as globals and the poll calls them; adding a section means adding
// a name here, not touching C++.
//
// A collector that fails to load leaves its section absent rather than breaking
// the poll: the driver checks for each one before calling it.
(function() {
	var files = [
		"collect/audio.tjs",
		"collect/visual.tjs",
		"collect/modes.tjs",
		"collect/conductor.tjs",
		"install/hooks.tjs",
		"install/console_helpers.tjs"
	];
	var loaded = 0;
	for (var i = 0; i < files.count; i++) {
		try {
			neuroExecFile("neuro_scripts/" + files[i], 1);
			loaded++;
		} catch (e) {
		}
	}
	return loaded;
})();
