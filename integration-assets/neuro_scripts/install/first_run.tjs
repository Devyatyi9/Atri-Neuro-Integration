(function() {
    // Applies the plugin's one-time settings to this save folder, and says what
    // happened: 0 the game is not ready yet, 1 already applied, 2 applied now.
    // Kept as a global function so the check can run it more than once.
    //
    // The mark lives in sf, which the game keeps in its own file next to the
    // saves: loading a save, starting a new game and returning to the title all
    // leave it alone. Its absence is what means "not applied", so it is written
    // only after the settings, and saved at once -- sf reaches the disk only when
    // saved, and a crash before the game's own save on exit would otherwise lose
    // it and apply everything again.
    global.__neuroFirstRun = function() {
        // Without the save there is no point writing the mark: it would be lost
        // at the next crash, so this counts as not ready. The same for the
        // function the settings go through.
        if (typeof global.kag != "Object" || typeof global.kag.sflags != "Object" ||
            typeof global.kag.saveSystemVariables != "Object" ||
            typeof global.setSysArgMenuItem != "Object") {
            return 0;
        }
        var s = global.kag.sflags;
        if (typeof s.neuroFirstRunApplied != "undefined" && s.neuroFirstRunApplied) {
            return 1;
        }

        // Automatic Cursor Placement off, so a dialog does not move the mouse.
        // The same call the options screen makes for its checkbox: it sets the
        // engine argument the game reads, and the engine keeps it in its own
        // user config, not in sf. The plugin config will be able to override it.
        global.setSysArgMenuItem("curmove", "no");

        s.neuroFirstRunApplied = true;
        global.kag.saveSystemVariables();
        return 2;
    };
    return global.__neuroFirstRun();
})();
