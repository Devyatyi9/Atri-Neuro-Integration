// Visual state for the context monitor. Keys are the field names the poll
// emits, so nothing translates between a variable and its `[name]`.
(function() {
	global.__cm_collectVisual = function() {
		return %[
			"bg_visible" => kag.back.base.visible,
			"fore_visible" => kag.fore.base.visible,
			"quake" => kag.quaking,
			"msg_hide" => kag.messageLayerHiding,
			"select" => kag.selectShowing,
			"noeffect" => kag.noeffect
		];
	} incontextof global;
	return 1;
})();
