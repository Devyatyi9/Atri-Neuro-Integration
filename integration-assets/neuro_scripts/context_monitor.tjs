(function(){
  // Poll game state - called by C++ every 200ms
  // Returns a string with changes or an empty string
  try {
    if (typeof kag == "undefined") return "";

    var info = kag.getCurrentInfo();
    var file = "" + info.file;
    var label = "" + info.label;
    var line = info.line;

    // --- Speaker identity (internal character ID, language-independent) ---
    //     currentText/currentName are deliberately NOT read here. They are native
    //     properties that bypass kag.getLangInfo and return the raw JP-authored
    //     tag value regardless of the active language, so they do not match what
    //     is actually on screen. Localized text/name comes from the hook below.
    var chara = "";
    if (typeof kag.historyLayer != "undefined") {
      var h = kag.historyLayer;
      if (typeof h.currentChara != "undefined") chara = h.currentChara;
    }

    // --- Localized text and speaker name, via a kag.getLangInfo call-through.
    //     getLangInfo(arg0, field) is the single choke point the engine's own
    //     renderer (rendermsgwin drawName/drawHistory, SelectLayer) goes through
    //     to resolve arg0.language[kag.languageType][field], so intercepting it
    //     yields exactly what the player sees.
    if (typeof global.__cm_origGetLangInfo == "undefined") {
      global.__cm_langText = "";
      global.__cm_langName = "";
      global.__cm_origGetLangInfo = kag.getLangInfo;
      kag.getLangInfo = function(arg0, arg1, arg2) {
        // The original declares `arg2 = languageType` as a default parameter.
        // A plain call-through wrapper does NOT get that default for free: an
        // ordinary 2-arg call (kag.getLangInfo(arg0, "text"), used everywhere)
        // leaves arg2 undefined here, and forwarding that explicit void to the
        // original does not trigger ITS default either -- arg0.language[void]
        // inside the original then indexes a native array out of bounds, which
        // is a real engine crash (Hardware exception raised), not a catchable
        // TJS error. This default MUST be preserved before calling through.
        if (arg2 === void) arg2 = kag.languageType;
        var r = global.__cm_origGetLangInfo(arg0, arg1, arg2);
        try {
          if (arg1 == "text") {
            global.__cm_langText = "" + r;
            // The entry itself, not just the rendered string: keeping it lets
            // the same line be read back in another language later, since
            // getLangInfo takes the language as its third argument. The raw
            // currentText property bypasses the language table entirely.
            global.__cm_langEntry = arg0;
          } else if (arg1 == "disp") global.__cm_langName = "" + r;
        } catch (e) {}
        return r;
      };
    }

    // --- Semantic event queue. Accumulated by hooks at the moment an event
    //     actually happens, drained once per poll. Hooks stay dumb collectors:
    //     they run on native dispatch paths, outside this poll's try/catch, so
    //     an uncaught exception in one reaches the engine and can be fatal.
    //     Field separator is \t, and free text is always the last field, so the
    //     C++ side can split on a fixed number of separators.
    if (typeof global.__cm_events == "undefined") global.__cm_events = [];

    // dialogue: fires on [p], i.e. once a page is fully shown. Localized values
    // come from the getLangInfo snapshot above, which is current at this point.
    if (typeof global.__cm_origP == "undefined") {
      global.__cm_origP = kag.tagHandlers["p"];
      kag.tagHandlers["p"] = function(p) {
        // This IS the [p] handler now. If the capture throws, the call-through
        // below must still run so [p] keeps working exactly as before.
        try {
          global.__cm_events.add("dialogue\t" + global.__cm_langName + "\t" + global.__cm_langText);
        } catch (e) {}
        return global.__cm_origP(p);
      };
    }

    // The backlog is a view, not a store: its getBlockCount/getBlockInfo proxy
    // into playerObject.getHistoryCount/getHistoryData, which hold the whole
    // conversation. The controller instance is not exposed, so the class method
    // is wrapped once and the instance caught as it goes by -- the same trick as
    // the save store below.
    if (typeof global.DragScrollableBacklog != "undefined" &&
        typeof global.__cm_origBlockInfo == "undefined") {
      global.__cm_backlog = void;
      global.__cm_origBlockInfo = global.DragScrollableBacklog.getBlockInfo;
      global.DragScrollableBacklog.getBlockInfo = function(a0) {
        global.__cm_backlog = this;
        return global.__cm_origBlockInfo(a0);
      };
    }

    // The save/load list has no readable "which page is showing" anywhere on the
    // screen: curpage.caption is empty and kag.current carries no index. The
    // store object does have it, but nothing exposes the instance -- so the
    // class method is wrapped once and the instance is caught as it goes by.
    //     onScrolled fires for both ways of paging, the page buttons and the
    //     mouse wheel, so neither can desync the reading. The instance dies with
    //     the screen ("The object is already invalidated"), which is why every
    //     read has to be guarded rather than cached.
    if (typeof global.EditableStoreScroll != "undefined" &&
        typeof global.__cm_origScrolled == "undefined") {
      global.__cm_saveStore = void;
      global.__cm_origScrolled = global.EditableStoreScroll.onScrolled;
      global.EditableStoreScroll.onScrolled = function(a0, a1) {
        global.__cm_saveStore = this;
        return global.__cm_origScrolled(a0, a1);
      };
    }

    // choice_made: the engine's own click dispatch, which is also what the
    // select_choice action calls. The button object carries the chosen option,
    // so its localized text comes from the same getLangInfo path as the render.
    //     The marker lives on the layer, not in a global, because kag.selectLayer
    //     is replaced over the session: a one-shot global guard would leave every
    //     later layer unhooked (observed 2026-08-19 -- the first choice after a
    //     scene entry emitted nothing). Marking the layer re-hooks each new one on
    //     the next poll, and keeping the saved original on the layer as well means
    //     the call-through runs with the correct owner as `this`.
    if (typeof kag.selectLayer != "undefined" &&
        typeof kag.selectLayer.onButtonClick != "undefined" &&
        typeof kag.selectLayer.__cm_hooked == "undefined") {
      kag.selectLayer.__cm_hooked = 1;
      kag.selectLayer.__cm_origClick = kag.selectLayer.onButtonClick;
      kag.selectLayer.onButtonClick = function(button) {
        try {
          global.__cm_events.add("choice_made\t" + kag.getLangInfo(button, "text"));
        } catch (e) {}
        return this.__cm_origClick(button);
      };
    }

    // --- State (which screen is active: game/title/option/cgmode/save/load/voice) ---
    var state = "";
    if (typeof SystemHook != "undefined") state = "" + SystemHook.currentState;

    // --- Narrative flags ---
    var moviePlaying = -1;
    if (typeof kag.isMoviePlaying != "undefined") moviePlaying = kag.isMoviePlaying();
    var bgChange = -1;
    if (typeof tf != "undefined" && typeof tf.bgchange != "undefined") bgChange = tf.bgchange;
    var recollect = -1;
    if (typeof tf != "undefined" && typeof tf.recollect != "undefined") recollect = tf.recollect;

    // --- Audio ---
    var bgm = "";
    if (typeof kag.bgm != "undefined") bgm = kag.bgm.playingStorage;
    var bgmPlaying = kag.bgm.inPlaying;
    var voiceRatio = kag.voicePlayingRatio;
    var voiceVol = kag.voicevolume;
    var voiceEnable = kag.voiceenable;
    var seVol = kag.sevolume;

    // --- Visual ---
    var bgVis = kag.back.base.visible;
    var foreVis = kag.fore.base.visible;
    var quake = kag.quaking;
    var msgHide = kag.messageLayerHiding;
    var selectShow = kag.selectShowing;
    var noeffect = kag.noeffect;

    // --- Modes ---
    var autoMode = kag._autoMode;
    var skipMode = kag._skipMode;

    // --- Conductor ---
    var status = kag.conductor.status;
    var lastTag = "" + kag.conductor.lastTagName;

    // --- Initialize globals ---
    if (typeof global.__cm_file == "undefined") global.__cm_file = "";
    if (typeof global.__cm_label == "undefined") global.__cm_label = "";
    if (typeof global.__cm_line == "undefined") global.__cm_line = -1;
    if (typeof global.__cm_chara == "undefined") global.__cm_chara = "";
    if (typeof global.__cm_lastLangText == "undefined") global.__cm_lastLangText = "";
    if (typeof global.__cm_lastLangName == "undefined") global.__cm_lastLangName = "";
    if (typeof global.__cm_state == "undefined") global.__cm_state = "";
    if (typeof global.__cm_moviePlaying == "undefined") global.__cm_moviePlaying = -1;
    if (typeof global.__cm_bgChange == "undefined") global.__cm_bgChange = -1;
    if (typeof global.__cm_recollect == "undefined") global.__cm_recollect = -1;
    if (typeof global.__cm_bgm == "undefined") global.__cm_bgm = "";
    if (typeof global.__cm_bgmPlaying == "undefined") global.__cm_bgmPlaying = -1;
    if (typeof global.__cm_voiceRatio == "undefined") global.__cm_voiceRatio = -1;
    if (typeof global.__cm_voiceVol == "undefined") global.__cm_voiceVol = -1;
    if (typeof global.__cm_voiceEnable == "undefined") global.__cm_voiceEnable = -1;
    if (typeof global.__cm_seVol == "undefined") global.__cm_seVol = -1;
    if (typeof global.__cm_bgVis == "undefined") global.__cm_bgVis = -1;
    if (typeof global.__cm_foreVis == "undefined") global.__cm_foreVis = -1;
    if (typeof global.__cm_quake == "undefined") global.__cm_quake = -1;
    if (typeof global.__cm_msgHide == "undefined") global.__cm_msgHide = -1;
    if (typeof global.__cm_selectShow == "undefined") global.__cm_selectShow = -1;
    if (typeof global.__cm_noeffect == "undefined") global.__cm_noeffect = -1;
    if (typeof global.__cm_autoMode == "undefined") global.__cm_autoMode = -1;
    if (typeof global.__cm_skipMode == "undefined") global.__cm_skipMode = -1;
    if (typeof global.__cm_status == "undefined") global.__cm_status = -1;
    if (typeof global.__cm_lastTag == "undefined") global.__cm_lastTag = "";

    var changes = "";

    if (file != global.__cm_file && file != "") {
      changes += "[scenario] " + file + "\n";
      global.__cm_file = file;
    }
    if (label != global.__cm_label && label != "") {
      changes += "[label] " + label + "\n";
      global.__cm_label = label;
    }
    if (line != global.__cm_line) {
      changes += "[line] " + line + "\n";
      global.__cm_line = line;
    }
    if (chara != global.__cm_chara) {
      changes += "[chara] " + chara + "\n";
      global.__cm_chara = chara;
    }

    if (state != global.__cm_state) {
      changes += "[state] " + state + "\n";
      global.__cm_state = state;
    }
    if (moviePlaying != global.__cm_moviePlaying) {
      changes += "[movie] " + moviePlaying + "\n";
      global.__cm_moviePlaying = moviePlaying;
    }
    if (bgChange != global.__cm_bgChange) {
      changes += "[bgchange] " + bgChange + "\n";
      global.__cm_bgChange = bgChange;
    }
    if (recollect != global.__cm_recollect) {
      changes += "[recollect] " + recollect + "\n";
      global.__cm_recollect = recollect;
    }

    // Audio
    if (bgm != global.__cm_bgm) {
      changes += "[bgm] " + bgm + "\n";
      global.__cm_bgm = bgm;
    }
    if (bgmPlaying != global.__cm_bgmPlaying) {
      changes += "[bgm_playing] " + bgmPlaying + "\n";
      global.__cm_bgmPlaying = bgmPlaying;
    }
    if (voiceRatio != global.__cm_voiceRatio) {
      changes += "[voice] " + voiceRatio + "\n";
      global.__cm_voiceRatio = voiceRatio;
    }
    if (voiceVol != global.__cm_voiceVol) {
      changes += "[voice_vol] " + voiceVol + "\n";
      global.__cm_voiceVol = voiceVol;
    }
    if (voiceEnable != global.__cm_voiceEnable) {
      changes += "[voice_enable] " + voiceEnable + "\n";
      global.__cm_voiceEnable = voiceEnable;
    }
    if (seVol != global.__cm_seVol) {
      changes += "[se_vol] " + seVol + "\n";
      global.__cm_seVol = seVol;
    }

    // Visual
    if (bgVis != global.__cm_bgVis) {
      changes += "[bg_visible] " + bgVis + "\n";
      global.__cm_bgVis = bgVis;
    }
    if (foreVis != global.__cm_foreVis) {
      changes += "[fore_visible] " + foreVis + "\n";
      global.__cm_foreVis = foreVis;
    }
    if (quake != global.__cm_quake) {
      changes += "[quake] " + quake + "\n";
      global.__cm_quake = quake;
    }
    if (msgHide != global.__cm_msgHide) {
      changes += "[msg_hide] " + msgHide + "\n";
      global.__cm_msgHide = msgHide;
    }
    if (selectShow != global.__cm_selectShow) {
      changes += "[select] " + selectShow + "\n";
      // choice_shown: only on the edge into "showing", and read here rather than
      // from a hook because the option list stays on screen until the player acts.
      // Compare against 1 explicitly: the initial value is -1, which is truthy in
      // TJS, so a `!previous` test would silently miss the very first choice of a
      // session (observed 2026-08-19 -- a save loaded straight into a choice
      // produced no event at all).
      if (selectShow && global.__cm_selectShow != 1) {
        try {
          var opts = kag.selectLayer.selects;
          var optLine = "choice_shown";
          for (var oi = 0; oi < opts.count; oi++) {
            optLine += "\t" + kag.getLangInfo(opts[oi], "text");
          }
          global.__cm_events.add(optLine);
        } catch (e) {}
      }
      global.__cm_selectShow = selectShow;
    }
    if (noeffect != global.__cm_noeffect) {
      changes += "[noeffect] " + noeffect + "\n";
      global.__cm_noeffect = noeffect;
    }

    // Modes
    if (autoMode != global.__cm_autoMode) {
      changes += "[auto] " + autoMode + "\n";
      global.__cm_autoMode = autoMode;
    }
    if (skipMode != global.__cm_skipMode) {
      changes += "[skip] " + skipMode + "\n";
      global.__cm_skipMode = skipMode;
    }

    // Conductor status
    if (status != global.__cm_status) {
      changes += "[status] " + status + "\n";
      global.__cm_status = status;
    }
    if (lastTag != global.__cm_lastTag) {
      changes += "[lastTag] " + lastTag + "\n";
      global.__cm_lastTag = lastTag;
    }

    // Correctly-localized text and speaker name in the active kag.languageType
    // (see the kag.getLangInfo call-through above). This is what actually
    // renders on screen, unlike the raw native properties.
    if (global.__cm_langText != global.__cm_lastLangText) {
      changes += "[lang_text] \"" + global.__cm_langText + "\"\n";
      global.__cm_lastLangText = global.__cm_langText;
    }
    if (global.__cm_langName != global.__cm_lastLangName) {
      changes += "[lang_name] \"" + global.__cm_langName + "\"\n";
      global.__cm_lastLangName = global.__cm_langName;
    }

    // Drain every semantic event queued since the last poll, in order. There
    // can be more than one per tick, unlike the single-value fields above.
    while (global.__cm_events.count > 0) {
      changes += "[event] " + global.__cm_events.shift() + "\n";
    }

    return changes;
  } catch(e) {
    return "";
  }
})();
