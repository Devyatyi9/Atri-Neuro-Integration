// One section of the context monitor, defined once at startup and called from
// the poll. Keeping it out of the poll script means the poll stays a driver:
// call the collectors, compare, build the line. Loading a file per poll would
// be far too expensive -- this runs inside tag dispatch.
//
// The keys are the field names the poll emits, so nothing has to translate
// between a variable and its `[name]`.
//
// Music comes from two different players and neither covers the other. In a
// scene it is an env layer of class "bgm", carrying the file in `_filename`;
// on the title and in menus it is `kag.bgm`. Reading only `kag.bgm`, as this
// did, left the field empty for the whole of the story -- the layers were
// playing BGM15, BGM13, BGM06 while the context said nothing.
//
// The layer is asked first and `kag.bgm` is the fallback, so both screens are
// covered rather than trading one for the other. Layer names change from scene
// to scene, so the layer is found by its class, not by name.
(function() {
	global.__cm_findSceneMusic = function() {
		// Guarded whole: this is reached from tag dispatch, where an escaping
		// exception is not caught by anything and costs the process. An empty
		// answer here simply means "no scene layer", which is a real state.
		try {
			var plugin = kag.kagPlugins[0];
			if (typeof plugin == "undefined") return void;
			var names = Scripts.getObjectKeys(plugin.envobjects);
			for (var i = 0; i < names.count; i++) {
				var layer = plugin.envobjects[names[i]];
				if (typeof layer._filename == "undefined") continue;
				if (layer.className != "bgm") continue;
				if (("" + layer._filename) == "") continue;
				return layer;
			}
		} catch (e) {}
		return void;
	} incontextof global;

	// The looping background effects, as one string. There can be several at
	// once (up to three layers were seen), their layer names change from scene
	// to scene, and what matters downstream is the set, not which slot holds
	// what -- so they travel joined, and any start or stop changes the string.
	global.__cm_collectLoops = function() {
		var names = [];
		try {
			var plugin = kag.kagPlugins[0];
			if (typeof plugin == "undefined") return "";
			var keys = Scripts.getObjectKeys(plugin.envobjects);
			for (var i = 0; i < keys.count; i++) {
				var layer = plugin.envobjects[keys[i]];
				if (typeof layer._filename == "undefined") continue;
				if (layer.className != "loopse") continue;
				if (!layer.playing) continue;
				var file = "" + layer._filename;
				if (file == "") continue;
				names.add(file);
			}
		} catch (e) {}
		return names.join(",");
	} incontextof global;

	// The voice file currently being spoken. `storage` keeps its value after
	// playback ends, so the buffer is asked whether it is playing before its
	// name is taken -- otherwise the last line would look like it never stops.
	global.__cm_collectVoiceFile = function() {
		try {
			for (var i = 0; i < kag.voices.count; i++) {
				var buffer = kag.voices[i];
				if (buffer.status != "play") continue;
				var storage = "" + buffer.storage;
				if (storage != "") return storage;
			}
		} catch (e) {}
		return "";
	} incontextof global;

	global.__cm_collectAudio = function() {
		var bgm = "";
		var playing = 0;

		var layer = global.__cm_findSceneMusic();
		// "Object", not "!= undefined": typeof a member holding void reports
		// "void", so an undefined test passes and the read below throws.
		if (typeof layer == "Object") {
			bgm = "" + layer._filename;
			playing = layer.playing;
		} else if (typeof kag.bgm != "undefined") {
			bgm = kag.bgm.playingStorage;
			playing = kag.bgm.inPlaying;
		}

		return %[
			"bgm" => bgm,
			"bgm_playing" => playing,
			"loopse" => global.__cm_collectLoops(),
			"voice_file" => global.__cm_collectVoiceFile(),
			"voice" => kag.voicePlayingRatio,
			"voice_vol" => kag.voicevolume,
			"voice_enable" => kag.voiceenable,
			"se_vol" => kag.sevolume
		];
	} incontextof global;
	return 1;
})();
