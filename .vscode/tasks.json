{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure: clangd Database",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}\\build\\clangd",
        "-G",
        "Ninja",
        "-DATRI_BUILD_PROTOTYPE=ON",
        "-DATRI_CONFIGURE_ALL_TARGETS=ON",
        "-DCMAKE_C_COMPILER=clang-cl",
        "-DCMAKE_CXX_COMPILER=clang-cl",
        "-DCMAKE_C_COMPILER_TARGET=i686-pc-windows-msvc",
        "-DCMAKE_CXX_COMPILER_TARGET=i686-pc-windows-msvc",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "Configure: Prototype Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "win32-prototype"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build: Prototype Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "win32-prototype-debug"
      ],
      "dependsOn": "Configure: Prototype Debug",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Configure: Prototype Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "win32-prototype"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build: Prototype Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "win32-prototype-release"
      ],
      "dependsOn": "Configure: Prototype Release",
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Configure: Clean Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "win32-clean"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build: Clean Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "win32-debug"
      ],
      "dependsOn": "Configure: Clean Debug",
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Configure: Clean Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "win32-clean"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build: Clean Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "win32-release"
      ],
      "dependsOn": "Configure: Clean Release",
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Format Check",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}\\Tools\\format.ps1",
        "-Check"
      ],
      "problemMatcher": []
    },
    {
      "label": "Deploy: Prototype Debug",
      "type": "shell",
      "command": "Copy-Item",
      "args": [
        "-LiteralPath",
        "${workspaceFolder}\\build\\prototype\\Debug\\Neuro-Integration.dll",
        "-Destination",
        "D:\\Games\\ATRI-TestVersion\\Neuro-Integration.dll",
        "-Force"
      ],
      "dependsOn": [
        "Build: Prototype Debug",
        "Deploy: Prototype Assets"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Deploy: Prototype Assets",
      "type": "shell",
      "command": "Copy-Item",
      "args": [
        "-Path",
        "${workspaceFolder}\\integration-assets\\neuro_scripts\\*",
        "-Destination",
        "D:\\Games\\ATRI-TestVersion\\neuro_scripts",
        "-Recurse",
        "-Force"
      ],
      "problemMatcher": []
    }
  ]
}
