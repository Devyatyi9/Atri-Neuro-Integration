// Temporary runtime probe. Run setup before a transition and restore after capture.
// Save the originals only when they are not already held. The test is "not a
// live function" rather than "undefined": a previous restore leaves the slots
// as void (typeof "void", not "undefined").
if (typeof kag.__neuroTransitionCaptureBegin != "Object") {
    kag.__neuroTransitionCaptureBegin = kag.beginTransition;
    kag.__neuroTransitionCaptureStop = kag.stopTransition;
}
kag.__neuroTransitionCaptureEvents = [];
// Every global below is written out in full. Inside a function held on an
// object, an unqualified name resolves against that object and does not fall
// back to global, so a bare `kag`, `Debug` or `System` here is void.
kag.beginTransition = function(params) {
    try {
        var event = "transition-begin tick=" + global.System.getTickCount() +
            ";method=" + params.method + ";time=" + params.time +
            ";rule=" + params.rule + ";before=" + global.kag.inTransition;
        global.kag.__neuroTransitionCaptureEvents.push(event);
        global.Debug.message(event);
    } catch (e) {}
    // Guarded: a restore leaves the saved slot void while this may still be
    // installed, and the engine drives the transition from here.
    var original = global.kag.__neuroTransitionCaptureBegin;
    if (typeof original == "Object") original(params);
};
kag.stopTransition = function() {
    try {
        var event = "transition-stop tick=" + global.System.getTickCount() +
            ";before=" + global.kag.inTransition;
        global.kag.__neuroTransitionCaptureEvents.push(event);
        global.Debug.message(event);
    } catch (e) {}
    var original = global.kag.__neuroTransitionCaptureStop;
    if (typeof original == "Object") original();
};
