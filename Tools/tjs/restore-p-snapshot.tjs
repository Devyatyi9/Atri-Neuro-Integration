// Restore the [p] tag handler after Tools/tjs/capture-p-snapshot.tjs.
// The IIFE returns 1 when it restored something and 0 otherwise, but a file
// ending in a semicolon runs as a function body under ExecuteTJSSync, which
// discards that value. Confirm instead with the guard member below: it reads
// "void" once the restore has run.
//
// Wrapped in an IIFE on purpose: ExecuteTJSSync only runs code as a function
// body when it finds a top-level statement separator. A bare `if (...) { ... }`
// keeps every `;` inside the braces, so it is treated as a single expression
// and wrapped as `return (...)` -- which is a syntax error for a statement.
//
// The guard tests for "Object" (a live function), not for "undefined": once a
// member has been assigned void, typeof reports "void", so an "undefined" test
// would pass again on a second run and assign void over the [p] handler,
// breaking dialogue advance.
(function() {
    if (typeof kag.__neuroPSnapshotOriginal != "Object") {
        return 0;
    }
    kag.tagHandlers["p"] = kag.__neuroPSnapshotOriginal;
    kag.__neuroPSnapshotOriginal = void;
    kag.__neuroPSnapshotEvents = void;
    return 1;
})();
