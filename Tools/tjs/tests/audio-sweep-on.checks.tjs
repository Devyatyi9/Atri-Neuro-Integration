// Checks for Tools/tjs/audio-sweep-on.tjs, run after it against the stubs.

// The polled half: layers are read by className, not by layer name, because
// names change from scene to scene.
global.__sweepSample();
assert(global.__sweepLog.count == 2, "two layers sampled, got " + global.__sweepLog.count);
assert(global.__sweepLog[0] == "b101.ks\tbgm\tBGM01", "bgm layer, got " + global.__sweepLog[0]);
assert(global.__sweepLog[1] == "b101.ks\tloopse\tse171", "loop layer, got " + global.__sweepLog[1]);

// Sampling twice must not repeat what has not changed.
global.__sweepSample();
assert(global.__sweepLog.count == 2, "unchanged layers logged twice");

// The scene is read when the event happens, not stamped later by the driver.
// Filing a whole drained batch under the scene the driver last knew about put
// four sounds in the wrong scene in the 2026-09-04 sweep.
kag.__stubScene = "b102.ks";
global.__stubEnvObjects["bgm"]._filename = "BGM07";
global.__sweepSample();
assert(global.__sweepLog.count == 3, "the changed layer was not logged");
assert(global.__sweepLog[2] == "b102.ks\tbgm\tBGM07",
	"the event kept the old scene, got " + global.__sweepLog[2]);
kag.__stubScene = "b101.ks";

// The event half: the wrapper has to call through and return what the original
// returned, or the tag pipeline silently loses its result.
var passed = kag.conductor.onTag("msg");
assert(passed == "orig-onTag:msg", "call-through lost the result, got " + passed);

// The failure that killed a three-hour sweep: the wrapper cannot be removed
// from a conductor a later scene replaced, so it outlives the run and finds its
// saved original gone. Unguarded, this throws eTJSError inside the engine's own
// dispatch and takes the process down with nothing in any log.
kag.conductor.__sweepOrigOnTag = void;
kag.conductor.onTag("msg");

// Same for the sampler, cleared by audio-sweep-off while a stale wrapper lives.
global.__sweepSample = void;
kag.conductor.onTag("msg");

return "audio-sweep-on: ok";
