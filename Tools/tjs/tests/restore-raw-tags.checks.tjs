// Checks for Tools/tjs/restore-raw-tags.tjs, run after capture-raw-tags.

assert(global.__scriptResult == 1, "restore did not report that it restored");

// The engine's handler is back: dispatching now reaches it and records nothing.
global.__stubCalls.clear();
kag.onConductorBeforeTag("cm", void);
assert(global.__stubCalls.count == 1, "the original handler is not back");
assert(global.__stubCalls[0] == "beforeTag:cm", "wrong handler, got " + global.__stubCalls[0]);

// What makes a second run a no-op: the saved slot is void, and the script's
// guard tests for a live function rather than for "undefined", so it returns 0
// instead of assigning void over the handler it just put back.
assert(typeof kag.__neuroRawTagsOriginal == "void", "the saved slot was left behind");
assert(typeof kag.__neuroRawTagsEvents == "void", "the event list was left behind");

return "restore-raw-tags: ok";
