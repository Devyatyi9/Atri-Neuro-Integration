// Stub game environment for running Tools/tjs scripts under tjsbox.
//
// The sandbox has only the TJS2 core -- no kag, no engine classes, and no
// Scripts.getObjectKeys, which comes from the scriptsEx plugin rather than the
// engine. Everything a script touches has to be built here, in TJS.
//
// Stubs are the point, not a workaround. The failures worth catching are states
// that are awkward to reach in a running game on purpose: a saved handler that
// has become void, a layer with no filename, an object replaced mid-scene. Here
// they are two lines.
//
// Keep this file to what the scripts under test actually reach for. A stub that
// grows to imitate the whole engine stops being readable and starts being wrong
// in ways nobody notices.
//
// One way these stubs can stop resembling the game: a dictionary as `this` cuts
// off global name resolution, while a class instance -- which is what kag really
// is -- does not. A hook installed on such a stub dies on its first bare `kag`
// or `Debug`, and the failure looks like a bug in the hook. kag is therefore
// built from a class below. The smaller stubs are still dictionaries, so if a
// check fails on a name that plainly exists, suspect this before the code.

global.Scripts = %[];
Scripts.getObjectKeys = function(obj) {
	// Only the collections the scripts enumerate need real answers.
	if (obj === global.__stubEnvObjects) return ["bgm", "se1", "se2", "se3"];
	return [];
};

// The class the sweep collector patches. In the game this is native.
global.EnvSoundBuffer = %[];
EnvSoundBuffer.play = function(a0, a1, a2, a3, a4) {
	return "orig-play:" + a0;
};

// Two sound layers of the two kinds the collector distinguishes: music-class
// (bgm, loopse) carry _filename, sound-class carry a sound object.
global.__stubEnvObjects = %[
	bgm: %[ className: "bgm", _filename: "BGM01", playing: 1 ],
	se1: %[ className: "loopse", _filename: "se171", playing: 1 ],
	se2: %[ className: "loopse", _filename: "se627", playing: 1 ],
	se3: %[ className: "loopse", _filename: "se279", playing: 0 ]
];

// A class instance, not a dictionary, and that difference is load-bearing. A
// hook installed on kag runs with kag as `this`, and code inside it reaches for
// globals by bare name -- `kag`, `Debug`, `tf`. With a dictionary as `this`
// those names resolve to void and the hook dies on its first line; with a class
// instance they resolve, which is what the real kag is and does. A stub that
// got this wrong reported working hooks as broken.
class StubKag { }
global.kag = new StubKag();
kag.kagPlugins = [ %[ envobjects: global.__stubEnvObjects ] ];
kag.voices = [ %[ storage: "ATR_b999_001.opus", status: "stop" ] ];
// Where the game currently is. The sweep collector stamps every event with it,
// so a stub that never changes would hide a collector that reads it once.
kag.__stubScene = "b101.ks";
kag.getCurrentInfo = function() {
	return %[ file: global.kag.__stubScene, label: global.kag.__stubLabel, line: 1 ];
};
kag.__stubLabel = "*start";

kag.conductor = %[];
kag.conductor.onTag = function(tag) { return "orig-onTag:" + tag; };

// Engine callbacks the capture probes replace. Each records that it ran, so a
// check can tell a wrapper that calls through from one that swallows the call.
global.__stubCalls = [];
kag.onConductorBeforeTag = function(tagname, tag) {
	global.__stubCalls.add("beforeTag:" + tagname);
};
kag.onMovieStatusChanged = function(status, movieId) {
	global.__stubCalls.add("movie:" + status + ":" + movieId);
};
kag.movies = [ %[ status: 1 ] ];

// The other music player. It serves the title and the menus, and in a scene it
// is empty -- which is the whole reason the collector cannot read only this.
kag.bgm = %[ playingStorage: "", inPlaying: 0 ];
kag.bgm.play = function(arg) { global.kag.bgm.playingStorage = arg.storage; };
kag.bgm.stop = function() { global.kag.bgm.playingStorage = ""; };
kag.se = [ %[] ];
kag.se[0].play = function(arg) { global.__stubCalls.add("se:" + arg.storage); };
kag.se[0].stop = function() { global.__stubCalls.add("se:stop"); };
kag.voices[0].stop = function() { global.__stubCalls.add("voice:stop"); };
kag.voices[0].open = function(n) { global.kag.voices[0].storage = n; };
kag.voices[0].totalTime = 3400;
kag.voices[0].play = function() { global.__stubCalls.add("voice:play"); };
kag.voicePlayingRatio = 0;
kag.voicevolume = 100;
kag.voiceenable = 1;
kag.sevolume = 80;
kag._sysMovieLayer = %[];
kag.isMoviePlaying = function() { return true; };

// Speed settings, at values a player might have left them at rather than at
// defaults: a round-trip check is only meaningful if the originals are unusual.
kag.textspeed = 30;
kag.autospeed = 45;
kag.drawspeed = 1;
kag.autoModeWaitVoice = 1;
kag.autoModePageWait = 3600;
kag.autoModeLineWait = 500;
kag._autoSpeedMax = 100;

// Skip. skipKeyPressing is what force-skip stubs out; the rest only record.
kag.skipMode = 0;
kag.skipKeyPressing = function() { return 0; };
kag.skipToStop2 = function() {
	global.__stubCalls.add("skipToStop2");
	global.kag.skipMode = 4;
};
kag.cancelSkip = function() {
	global.__stubCalls.add("cancelSkip");
	global.kag.skipMode = 0;
};

// Localization getter, hooked by capture-multilang. The third argument has a
// default in the engine; here it is required, so a wrapper that forwards void
// is caught rather than quietly reading the wrong language.
kag.languageType = 1;
kag.getLangInfo = function(obj, field, langType) {
	if (langType === void) throw new Exception("getLangInfo called without a language");
	// A marked entry answers with a line shaped like the ones in the scenario:
	// every inline directive the texts actually use, and a paragraph break of
	// the kind the diary inserts are written with.
	if (obj.markup && field == "text") {
		return "%n3;xx/xx/xx \nI woke %i1up%id. %f源ノ角ゴシックB;♪%fuser;";
	}
	return "lang" + langType + ":" + field;
};

// Tag handlers, hooked by capture-p-snapshot. A handler lives on this
// dictionary rather than on kag, which is what makes `this` there not kag.
kag.tagHandlers = %[];
kag.tagHandlers["p"] = function(p) {
	global.__stubCalls.add("tag:p");
	return "orig-p";
};
kag.historyLayer = %[ currentName: "ATRI", currentText: "line" ];

// Transitions, hooked by capture-transition-timing.
kag.inTransition = false;
kag.beginTransition = function(params) { global.__stubCalls.add("beginTransition"); };
kag.stopTransition = function() { global.__stubCalls.add("stopTransition"); };

// What the context monitor and its collectors read beyond the audio above.
// Values are set to something other than the emptiest possible reading, so a
// poll that reports nothing is a real failure rather than a field that happens
// to match its own default.
global.SystemHook = %[ currentState: "game" ];
global.tf = %[ bgchange: 0, recollect: 0 ];
kag.back = %[ base: %[ visible: true ] ];
kag.fore = %[ base: %[ visible: true ] ];
kag.quaking = false;
kag.messageLayerHiding = false;
kag.selectShowing = 0;
kag.noeffect = false;
kag._autoMode = false;
kag._skipMode = 0;
kag.conductor.status = "run";
kag.conductor.lastTagName = "msg";
kag.historyLayer.currentChara = "atri";
// The choice list, read on the edge into "showing". Entries go through
// getLangInfo like any other localized string -- and the second one is marked,
// because the poll reads these itself rather than through the hook, and that is
// the route where a directive would slip past uncleaned.
kag.selectLayer = %[ selects: [ %[ text: "yes" ], %[ text: "no", markup: true ] ] ];
// The engine's own click dispatch, which the choice action also goes through.
// It records the owner it ran with, because the hook has to call the original
// back with the layer as `this` rather than as a loose function.
kag.selectLayer.onButtonClick = function(button) {
	global.__stubCalls.add("click:" + (this === global.kag.selectLayer ? "layer" : "other"));
	return "orig-click";
};

// The save/load list's scroll. A class, not a dictionary, because the hook
// patches the class and the instance has to carry the patched member -- which
// is the whole reason that hook is written the way it is.
class StubStoreScroll {
	function onScrolled(a0, a1) {
		global.__stubCalls.add("scrolled:" + (this === global.__stubScrollInstance ? "instance" : "other"));
		return "orig-scrolled";
	}
}
global.EditableStoreScroll = StubStoreScroll;

// The gallery and the backlog are caught the same way: a class method wrapped
// once, the instance taken as it goes past. Same shape, same failure if the
// call-through forgets its owner.
class StubGallery {
	function isSeenOne(a0, a1) {
		global.__stubCalls.add("seen:" + (this === global.__stubGalleryInstance ? "instance" : "other"));
		return "orig-seen";
	}
	function focusView() {
		global.__stubCalls.add("focus:" + (this === global.__stubGalleryInstance ? "instance" : "other"));
		return "orig-focus";
	}
}
global.CgGalleryMode = StubGallery;
global.__stubGalleryInstance = void;

class StubBacklog {
	function getBlockInfo(a0) {
		global.__stubCalls.add("block:" + (this === global.__stubBacklogInstance ? "instance" : "other"));
		return "orig-block";
	}
}
global.DragScrollableBacklog = StubBacklog;
global.__stubBacklogInstance = void;
// The instance is built by the check, after the hook is installed: TJS copies a
// class's members into an object as it is constructed, so one made earlier would
// carry the unpatched method and quietly test nothing.
global.__stubScrollInstance = void;

// Provided by the engine's own script layer, which the sandbox does not compile.
global.Debug = %[];
Debug.message = function(text) { global.__stubCalls.add("debug:" + text); };
global.System = %[];
System.getTickCount = function() { return 1000; };

// Exported by the plugin, so absent here in exactly the way they are absent
// from any process the plugin failed to load into.
global.Neuro = %[
    execFile: function(path, mode) { return ""; },
    sendContextFromTJS: function(data) { }
];

// Assertion helper for the checks files. Throwing is how a check fails: tjsbox
// reports the message with a line number and exits non-zero.
global.assert = function(condition, what) {
	if (!condition) throw new Exception("check failed: " + what);
};
