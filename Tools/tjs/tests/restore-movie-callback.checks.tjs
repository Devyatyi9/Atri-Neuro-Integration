// Checks for Tools/tjs/restore-movie-callback.tjs, run after the capture.

assert(global.__scriptResult == 1, "restore did not report that it restored");

global.__stubCalls.clear();
kag.onMovieStatusChanged(2, 0);
assert(global.__stubCalls.count == 1, "the original callback is not back");
assert(global.__stubCalls[0] == "movie:2:0", "wrong callback, got " + global.__stubCalls[0]);

assert(typeof kag.__neuroMovieCaptureOriginal == "void", "the saved slot was left behind");
assert(typeof kag.__neuroMovieCaptureEvents == "void", "the event list was left behind");

return "restore-movie-callback: ok";
