// Restore the transition functions after Tools/tjs/capture-transition-timing.tjs.
// Returns 1 if something was restored, 0 if there was nothing to restore.
//
// The guard tests for "Object" (a live function), not for "undefined": once a
// member has been assigned void, typeof reports "void", so an "undefined" test
// would pass again on a second run and assign void over the very function this
// just restored. Running this twice must be a no-op.
if (typeof kag.__neuroTransitionCaptureBegin != "Object") {
    return 0;
}
kag.beginTransition = kag.__neuroTransitionCaptureBegin;
kag.stopTransition = kag.__neuroTransitionCaptureStop;
kag.__neuroTransitionCaptureBegin = void;
kag.__neuroTransitionCaptureStop = void;
kag.__neuroTransitionCaptureEvents = void;
return 1;
