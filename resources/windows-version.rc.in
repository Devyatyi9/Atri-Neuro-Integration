#include <windows.h>
#include <winver.h>

#define ATRI_FILE_VERSION 0, 1, 0, 0
#define ATRI_FILE_VERSION_STRING "0.1.0.0"
#define ATRI_PRODUCT_VERSION 0, 1, 0, 0
#define ATRI_PRODUCT_VERSION_STRING "0.1.0.0"
#define ATRI_COMPANY_NAME ""
#define ATRI_PRODUCT_NAME "ATRI Neuro Integration"
#define ATRI_LEGAL_COPYRIGHT ""

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ATRI_FILE_VERSION
 PRODUCTVERSION ATRI_PRODUCT_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", ATRI_COMPANY_NAME
            VALUE "FileDescription", "@ATRI_FILE_DESCRIPTION@"
            VALUE "FileVersion", ATRI_FILE_VERSION_STRING
            VALUE "InternalName", "@ATRI_ORIGINAL_FILENAME@"
            VALUE "LegalCopyright", ATRI_LEGAL_COPYRIGHT
            VALUE "OriginalFilename", "@ATRI_ORIGINAL_FILENAME@"
            VALUE "ProductName", ATRI_PRODUCT_NAME
            VALUE "ProductVersion", ATRI_PRODUCT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
